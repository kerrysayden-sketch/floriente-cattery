# Template: documents which env vars this project requires.
# DO NOT put real values here. DO NOT copy this to .env for local dev.
#
# Local dev: values come from macOS Keychain via scripts/load-env.sh,
# which npm run dev/build/preview source automatically.
# To set up a new machine, see README section "Secrets handling".
#
# Production (Cloudflare Pages): set as Secret in Pages project env.

STORYBLOK_TOKEN=

# Build-time PUBLIC var (baked into the client). Optional — when set, the
# waitlist form renders the Cloudflare Turnstile widget. Set the SAME value in
# the Cloudflare Pages build environment. Runtime function secrets (Resend,
# Turnstile secret, Google) live in .dev.vars locally — see .dev.vars.example.
PUBLIC_TURNSTILE_SITE_KEY=
