---
import { commercialStatusColor, commercialStatusLabel } from '../../lib/kittens';
import type { CommercialStatus } from '../../lib/kittens';
import type { Lang } from '../../i18n/utils';

interface Props {
  /** `null` means "not stated" — a valid state that renders no badge at all. */
  status: CommercialStatus | null;
  lang: Lang;
}

const { status, lang } = Astro.props;
const label = commercialStatusLabel(status, lang);
---

{label && (
  <span class:list={[
    'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium text-warm-white',
    commercialStatusColor(status),
  ]}>
    <span class="w-1.5 h-1.5 rounded-full bg-warm-white/60"></span>
    {label}
  </span>
)}
