---
import { localizedBreed } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { kittenDetailPath, kittenImage } from '../../lib/kittens';
import type { KittenEntry } from '../../lib/kittens';
import StatusBadge from './StatusBadge.astro';

interface Props {
  /** Always a published entity — drafts never reach a card. */
  kitten: KittenEntry;
  lang: Lang;
}

const { kitten, lang } = Astro.props;
const k = kitten.data;
const profileUrl = kittenDetailPath(k.kittenId, lang);
const photo = kittenImage(kitten, 'cardImage');
---

<a
  href={profileUrl}
  class="group block rounded-lg overflow-hidden bg-warm-white border border-gray-light hover:border-gold/50 transition-all duration-300 hover:shadow-lg"
  data-status={k.commercialStatus ?? 'none'}
  data-breed={k.breedCode}
  data-sex={k.sex}
>
  <div class="relative overflow-hidden aspect-square">
    <img
      src={photo.src}
      alt={k.homeName}
      width={photo.width}
      height={photo.height}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute top-3 left-3">
      <StatusBadge status={k.commercialStatus} lang={lang} />
    </div>
    {k.sex === 'male' ? (
      <div class="absolute top-3 right-3 w-7 h-7 rounded-full bg-blue-soft/80 text-warm-white flex items-center justify-center text-xs font-bold">♂</div>
    ) : (
      <div class="absolute top-3 right-3 w-7 h-7 rounded-full bg-status-home/80 text-warm-white flex items-center justify-center text-xs font-bold">♀</div>
    )}
  </div>
  <div class="p-4">
    <h3 class="font-serif text-lg">{k.homeName}</h3>
    <p class="text-sm text-gray-medium mt-1">{localizedBreed(k.breed, k.sex, lang)}</p>
    <p class="text-[11px] text-gray-300 mt-0.5">{k.passportName}</p>
  </div>
</a>
