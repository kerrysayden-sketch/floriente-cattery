---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../cats/StatusBadge.astro';
import CatGallery from '../cats/CatGallery.astro';
import { t, getLocalizedPath, localizedBreed } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { kittenImage } from '../../lib/kittens';
import type { KittenEntry, KittenCopyEntry } from '../../lib/kittens';
import { whatsappLink } from '../../lib/whatsapp';

interface Props {
  lang: Lang;
  /** Published entities only — the route is not generated for drafts. */
  kitten: KittenEntry;
  /** Guaranteed present: the router asserts five-locale copy before publishing. */
  copy: KittenCopyEntry;
}

const { lang, kitten, copy } = Astro.props;
const k = kitten.data;
const c = copy.data;

const hero = kittenImage(kitten, 'heroImage');
const breedLabel = localizedBreed(k.breed, k.sex, lang);

// Description lives in the markdown body, split on blank lines — the same
// convention as src/content/cats/. No English fallback: a missing locale is a
// build failure, not a silent substitution.
const paragraphs = copy.body?.trim().split('\n\n').filter(Boolean) ?? [];

// Gallery keeps deterministic source order (n = 1..4) until an owner-approved
// order exists. Captions are localized and optional.
const captionFor = (n: number) => c.captions.find((x) => x.n === n)?.text;
const gallery = k.images
  .slice()
  .sort((a, b) => a.n - b.n)
  .map((img) => ({ src: img.src, label: captionFor(img.n) }));

// Shares the GlobalLightbox group with the hero, so the hero opens the gallery.
const galleryId = `kitten-${k.kittenId}`;

const title = c.metaTitle || `${k.homeName} — Floriente Cattery`;
const description = c.metaDescription || paragraphs[0] || `${k.homeName} · ${breedLabel}`;
---

<BaseLayout title={title} description={description} lang={lang} ogImage={hero.src}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <nav class="text-sm text-gray-medium mb-8">
      <a href={getLocalizedPath('/', lang)} class="hover:text-gold">{t(lang, 'nav.home')}</a>
      <span class="mx-2">/</span>
      <a href={getLocalizedPath('/kittens/', lang)} class="hover:text-gold">{t(lang, 'nav.kittens')}</a>
      <span class="mx-2">/</span>
      <span class="text-dark">{k.homeName}</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14">
      <div>
        <div class="relative aspect-[3/4] rounded-lg overflow-hidden bg-gray-light/50" data-lightbox-gallery={`cat-${galleryId}`}>
          <img
            src={hero.src}
            alt={c.alt}
            width={hero.width}
            height={hero.height}
            class="w-full h-full object-cover"
            loading="eager"
          />
          <div class="absolute top-4 left-4"><StatusBadge status={k.commercialStatus} lang={lang} /></div>
        </div>
      </div>

      <div>
        <h1 class="text-3xl md:text-4xl text-dark mb-1">{k.homeName}</h1>
        <p class="text-sm text-gray-medium mb-6">{k.passportName}</p>

        <dl class="space-y-3 mb-8">
          <div class="flex"><dt class="w-32 text-sm text-gray-medium">{t(lang, 'kittens.fieldBreed')}</dt><dd class="text-sm text-dark">{breedLabel}</dd></div>
          <div class="flex"><dt class="w-32 text-sm text-gray-medium">{t(lang, 'kittens.fieldColor')}</dt><dd class="text-sm text-dark">{c.colorLabel} <span class="text-gray-medium">({k.ems})</span></dd></div>
          <div class="flex"><dt class="w-32 text-sm text-gray-medium">{t(lang, 'kittens.fieldSex')}</dt><dd class="text-sm text-dark">{k.sex === 'male' ? '♂ ' + t(lang, 'kittens.male') : '♀ ' + t(lang, 'kittens.female')}</dd></div>
          <div class="flex"><dt class="w-32 text-sm text-gray-medium">{t(lang, 'kittens.fieldBorn')}</dt><dd class="text-sm text-dark">{k.dob}</dd></div>
        </dl>

        {c.traits.length > 0 && (
          <ul class="flex flex-wrap gap-2 mb-8 list-none p-0">
            {c.traits.map((trait) => (
              <li class="px-3 py-1 rounded-full bg-gold/10 text-gold text-xs font-medium">{trait}</li>
            ))}
          </ul>
        )}

        {paragraphs.length > 0 && (
          <div class="space-y-4 mb-8">
            {paragraphs.map((p) => <p class="text-dark-soft text-sm md:text-base leading-relaxed">{p}</p>)}
          </div>
        )}

        <a
          href={whatsappLink(lang, 'nextLitter', k.homeName)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-3.5 bg-gold text-warm-white font-medium rounded hover:bg-gold-dark transition-colors text-sm uppercase tracking-wider"
        >{t(lang, 'kittens.availabilityCta')}</a>
      </div>
    </div>

    <div class="mt-10 md:mt-14">
      <CatGallery photos={gallery} catName={c.alt} galleryId={galleryId} />
    </div>
  </div>
</BaseLayout>
