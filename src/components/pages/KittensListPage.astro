---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KittensPreview from '../home/KittensPreview.astro';
import { t, getLocalizedPath, localizedBreed } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getPublishedKittensByLitter, getKittenCopy, kittenDetailPath, kittenImage,
         commercialStatusLabel, commercialStatusColor, getPreviewFeaturedKittens } from '../../lib/kittens';
import { whatsappLink } from '../../lib/whatsapp';

interface Props { lang: Lang; }
const { lang } = Astro.props;

// Litters A and B below are historical content and stay hardcoded, untouched.
// Litter C onward comes from the content collection, and only ever published
// entities: `getPublishedKittensByLitter` filters drafts out at the source.
const litterC = await getPublishedKittensByLitter('c');

// KittensPreview sits in components/home/ for historical reasons, but
// HomePage.astro does not render it — its only mount point is the top of this
// listing, which is what `featuredInKittensPreview` names. Show it only when it
// has something to show. Featuring is the sole trigger: a published-but-
// unfeatured kitten appears in the Litter C block below and nowhere else.
const previewKittens = await getPreviewFeaturedKittens();
const litterCCopy = new Map(
  await Promise.all(
    litterC.map(async (k) => [k.data.kittenId, await getKittenCopy(k.data.kittenId, lang)] as const),
  ),
);

const litterA = [
  { name: 'Salma', full: 'Al Muad\'Dib Salma Ole Lukhoye', photo: '/images/kittens/litter-a/salma.webp', sex: 'female', breed: 'Oriental Shorthair', color: 'Black spotted tabby' },
  { name: 'Milky', full: 'Alt Milky Ole Lukhoye', photo: '/images/kittens/litter-a/milky.webp', sex: 'male', breed: 'Siamese', color: 'Chocolate point' },
  { name: 'Astra', full: 'Astra Shakhty Ole Lukhoye', photo: '/images/kittens/litter-a/astra.webp', sex: 'female', breed: 'Oriental Shorthair', color: 'Black' },
  { name: 'Asya', full: 'Asya Ole Lukhoye', photo: '/images/kittens/litter-a/asya.webp', sex: 'female', breed: 'Oriental Shorthair', color: 'Black spotted tabby' },
  { name: 'Axel', full: 'Axel Cornelius Ole Lukhoye', photo: '/images/kittens/litter-a/axel.webp', sex: 'male', breed: 'Oriental Shorthair', color: 'Black spotted tabby' },
];

const litterB = [
  { name: 'Bantik', full: 'Bantik Ole Lukhoye', photo: '/images/kittens/litter-b/bantik.webp', sex: 'male', breed: 'Siamese', color: 'Seal point' },
  { name: 'Barbie', full: 'Barbie Ole Lukhoye', photo: '/images/kittens/litter-b/barbie.webp', sex: 'female', breed: 'Oriental Shorthair', color: 'Chocolate spotted tabby' },
  { name: 'Bars', full: 'Bars Ole Lukhoye', photo: '/images/kittens/litter-b/bars.webp', sex: 'male', breed: 'Siamese', color: 'Seal point' },
  { name: 'Barton', full: 'Barton Ole Lukhoye', photo: '/images/kittens/litter-b/barton.webp', sex: 'male', breed: 'Oriental Shorthair', color: 'Chocolate' },
  { name: 'Bead', full: 'Bead Ole Lukhoye', photo: '/images/kittens/litter-b/bead.webp', sex: 'female', breed: 'Oriental Shorthair', color: 'Black spotted tabby' },
  { name: 'Benjamin', full: 'Benjamin Ole Lukhoye', photo: '/images/kittens/litter-b/benjamin.webp', sex: 'male', breed: 'Oriental Shorthair', color: 'Black spotted tabby' },
  { name: 'Bill', full: 'Bill Ole Lukhoye', photo: '/images/kittens/litter-b/bill.webp', sex: 'male', breed: 'Siamese', color: 'Seal point' },
  { name: 'Buddy', full: 'Buddy Ole Lukhoye', photo: '/images/kittens/litter-b/buddy.webp', sex: 'male', breed: 'Oriental Shorthair', color: 'Black spotted tabby' },
];

const badgeLabel = t(lang, 'kittens.atNewHome');
const litterATitle = t(lang, 'kittens.litterATitle');
const litterBTitle = t(lang, 'kittens.litterBTitle');
const pageSubtitle = t(lang, 'kittens.pageSubtitle');
const litterAMeta = t(lang, 'kittens.litterAMeta');
const litterBMeta = t(lang, 'kittens.litterBMeta');
const waitlistText = t(lang, 'kittens.waitlistText');
const hiText = t(lang, 'kittens.hiText');
---

<BaseLayout
  title={t(lang, 'pages.kittens.title')}
  description={t(lang, 'pages.kittens.description')}
  lang={lang}
>
  {previewKittens.length > 0 && <KittensPreview lang={lang} />}

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <h1 class="text-center text-dark mb-4">{t(lang, 'nav.kittens')}</h1>
    <p class="text-center text-gray-medium mb-8 max-w-2xl mx-auto">{pageSubtitle}</p>

    <div class="max-w-2xl mx-auto text-center mb-12 md:mb-16 py-8 px-6 bg-gold/5 rounded-2xl border border-gold/10">
      {litterC.length === 0 && (
        <p class="text-dark text-lg mb-2">{t(lang, 'kittens.availabilityNone')}</p>
      )}
      <p class="text-dark-soft mb-6">{t(lang, 'kittens.availabilityNext')}</p>
      <a
        href={whatsappLink(lang, 'nextLitter')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-8 py-3 bg-gold text-warm-white font-medium rounded hover:bg-gold-dark transition-colors text-sm"
      >{t(lang, 'kittens.availabilityCta')}</a>
      <p class="text-dark-soft text-sm mt-4">
        {t(lang, 'kittens.waitlistPrompt')}
        <a href={getLocalizedPath('/kittens/waitlist/', lang)} class="text-gold hover:text-gold-dark underline underline-offset-2">{t(lang, 'kittens.waitlistFormLink')}</a>
      </p>
    </div>

    {litterC.length > 0 && (
      <section class="mb-14 md:mb-20">
        <div class="flex items-center gap-4 mb-2">
          <h2 class="text-2xl md:text-3xl text-dark">{t(lang, 'kittens.litterCTitle')}</h2>
          <div class="flex-1 h-px bg-gray-light"></div>
        </div>
        <p class="text-sm text-gray-medium mb-8">{t(lang, 'kittens.litterCMeta')}</p>

        <div id="kitten-filters" class="flex flex-wrap gap-2 justify-center mb-4">
          <span class="text-xs text-gray-medium uppercase tracking-wider mr-2 self-center">{t(lang, 'kittens.statusLabel')}</span>
          <button data-filter="status" data-value="all" class="filter-btn active px-3 py-1.5 rounded-full text-xs font-medium border border-gold bg-gold text-warm-white transition-colors">{t(lang, 'kittens.statusAll')}</button>
          <button data-filter="status" data-value="available" class="filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-gray-light text-dark-soft hover:border-gold hover:text-gold transition-colors">{t(lang, 'kittens.statusAvailable')}</button>
          <button data-filter="status" data-value="reserved" class="filter-btn px-3 py-1.5 rounded-full text-xs font-medium border border-gray-light text-dark-soft hover:border-gold hover:text-gold transition-colors">{t(lang, 'kittens.statusReserved')}</button>
        </div>

        <div id="kitten-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
          {litterC.map((entry) => {
            const k = entry.data;
            const photo = kittenImage(entry, 'cardImage');
            const statusLabel = commercialStatusLabel(k.commercialStatus, lang);
            const colorLabel = litterCCopy.get(k.kittenId)?.data.colorLabel;
            return (
              <a href={kittenDetailPath(k.kittenId, lang)} class="kitten-card text-center group" data-status={k.commercialStatus ?? 'none'}>
                <div class="relative mx-auto w-72 h-72 sm:w-60 sm:h-60 md:w-64 md:h-64 mb-3">
                  <div class="w-full h-full rounded-full overflow-hidden border-2 border-gray-200 group-hover:border-gold/40 group-hover:shadow-md transition-all duration-300 shadow-sm">
                    <img src={photo.src} alt={k.homeName} width={photo.width} height={photo.height} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                  </div>
                  {statusLabel && (
                    <span class={`absolute top-0 left-0 inline-flex items-center px-3.5 py-1.5 rounded-full text-sm font-bold text-warm-white shadow-sm ${commercialStatusColor(k.commercialStatus)}`}>{statusLabel}</span>
                  )}
                </div>
                <h3 class="text-lg md:text-xl font-serif text-dark-soft">
                  {hiText} <strong class="text-dark">{k.homeName}</strong>
                  <span class={`ml-1.5 text-lg font-bold ${k.sex === 'male' ? 'text-blue-400' : 'text-pink-400'}`}>{k.sex === 'male' ? '♂' : '♀'}</span>
                </h3>
                <p class="text-xs text-gray-medium mt-1 leading-tight">{localizedBreed(k.breed, k.sex, lang)}{colorLabel ? ` · ${colorLabel}` : ''}</p>
                <p class="text-[11px] text-gray-300 mt-0.5 leading-tight">{k.passportName}</p>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="mb-14 md:mb-20">
      <div class="flex items-center gap-4 mb-2">
        <h2 class="text-2xl md:text-3xl text-dark">{litterBTitle}</h2>
        <div class="flex-1 h-px bg-gray-light"></div>
      </div>
      <p class="text-sm text-gray-medium mb-8">{litterBMeta}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        {litterB.map((kitten) => (
          <div class="text-center group">
            <div class="relative mx-auto w-72 h-72 sm:w-60 sm:h-60 md:w-64 md:h-64 mb-3">
              <div class="w-full h-full rounded-full overflow-hidden border-2 border-gray-200 group-hover:border-gold/40 group-hover:shadow-md transition-all duration-300 shadow-sm">
                {kitten.photo ? (
                  <img src={kitten.photo} alt={kitten.full} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-warm-white flex items-center justify-center">
                    <img src="/images/floriente_dark_navy_transparent.webp" alt="Floriente Cattery" class="w-28 h-28 opacity-15" />
                  </div>
                )}
              </div>
              <span class="absolute top-0 left-0 inline-flex items-center px-3.5 py-1.5 rounded-full text-sm font-bold text-warm-white bg-status-home shadow-sm">{badgeLabel}</span>
            </div>
            <h3 class="text-lg md:text-xl font-serif text-dark-soft">
              {hiText} <strong class="text-dark">{kitten.name}</strong>
              <span class={`ml-1.5 text-lg font-bold ${kitten.sex === 'male' ? 'text-blue-400' : 'text-pink-400'}`}>{kitten.sex === 'male' ? '♂' : '♀'}</span>
            </h3>
            <p class="text-xs text-gray-medium mt-1 leading-tight">{localizedBreed(kitten.breed, kitten.sex, lang)}</p>
            <p class="text-[11px] text-gray-300 mt-0.5 leading-tight">{kitten.full}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-14 md:mb-20">
      <div class="flex items-center gap-4 mb-2">
        <h2 class="text-2xl md:text-3xl text-dark">{litterATitle}</h2>
        <div class="flex-1 h-px bg-gray-light"></div>
      </div>
      <p class="text-sm text-gray-medium mb-8">{litterAMeta}</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10">
        {litterA.map((kitten) => (
          <div class="text-center group">
            <div class="relative mx-auto w-72 h-72 sm:w-44 sm:h-44 md:w-48 md:h-48 mb-3">
              <div class="w-full h-full rounded-full overflow-hidden border-2 border-gray-200 group-hover:border-gold/40 group-hover:shadow-md transition-all duration-300 shadow-sm">
                <img src={kitten.photo} alt={kitten.full} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>
              <span class="absolute top-0 left-0 inline-flex items-center px-3.5 py-1.5 rounded-full text-sm font-bold text-warm-white bg-status-home shadow-sm">{badgeLabel}</span>
            </div>
            <h3 class="text-lg md:text-xl font-serif text-dark-soft">
              {hiText} <strong class="text-dark">{kitten.name}</strong>
              <span class={`ml-1.5 text-lg font-bold ${kitten.sex === 'male' ? 'text-blue-400' : 'text-pink-400'}`}>{kitten.sex === 'male' ? '♂' : '♀'}</span>
            </h3>
            <p class="text-xs text-gray-medium mt-1 leading-tight">{localizedBreed(kitten.breed, kitten.sex, lang)}</p>
            <p class="text-[11px] text-gray-300 mt-0.5 leading-tight">{kitten.full}</p>
          </div>
        ))}
      </div>
    </section>

    <div class="text-center py-10 bg-gold/5 rounded-2xl border border-gold/10">
      <p class="text-dark-soft text-lg mb-4">{waitlistText}</p>
      <a href={getLocalizedPath('/kittens/waitlist/', lang)} class="inline-block px-8 py-3 bg-gold text-warm-white font-medium rounded hover:bg-gold-dark transition-colors text-sm uppercase tracking-wider">{t(lang, 'home.kittensJoinWaitlist')}</a>
    </div>
  </div>
</BaseLayout>

<script>
  const grid = document.getElementById('kitten-grid');
  const empty = document.getElementById('filter-empty');
  const activeFilters = { status: 'all', breed: 'all', sex: 'all' };

  function applyFilters() {
    if (!grid) return;
    const cards = grid.querySelectorAll('[data-status]');
    let visibleCount = 0;
    cards.forEach((card) => {
      const el = card as HTMLElement;
      const matchStatus = activeFilters.status === 'all' || el.dataset.status === activeFilters.status;
      if (matchStatus) { el.style.display = ''; visibleCount++; }
      else { el.style.display = 'none'; }
    });
    if (empty) empty.classList.toggle('hidden', visibleCount > 0);
  }

  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterType = btn.getAttribute('data-filter') as keyof typeof activeFilters;
      const value = btn.getAttribute('data-value') || 'all';
      activeFilters[filterType] = value;
      const siblings = document.querySelectorAll(`[data-filter="${filterType}"]`);
      siblings.forEach((b) => { b.classList.remove('active', 'bg-gold', 'text-warm-white', 'border-gold'); b.classList.add('border-gray-light', 'text-dark-soft'); });
      btn.classList.add('active', 'bg-gold', 'text-warm-white', 'border-gold');
      btn.classList.remove('border-gray-light', 'text-dark-soft');
      applyFilters();
    });
  });
</script>
