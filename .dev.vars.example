# Template for LOCAL Pages-function secrets used by `wrangler pages dev`.
# Copy to `.dev.vars` (gitignored) and fill with REAL values for local e2e.
# DO NOT put real values here. DO NOT commit `.dev.vars`.
#
# In preview/production these are set as env vars / secrets in the
# Cloudflare Pages project (Settings → Environment variables). See WAITLIST-SETUP.md.

# ── Safety mode ──────────────────────────────────────────────
# Allow degraded mode (skip unconfigured notify AND D1, still return 200).
# Set 'true' for LOCAL development only. Do NOT set it in Preview or Production
# — both run STRICT/live, so a missing notify config OR missing/failed D1
# returns 500 instead of silently accepting and losing a lead.
WAITLIST_ALLOW_DEGRADED=true

# ── Notification email (Resend) ──────────────────────────────
# In LOCAL degraded mode these may be empty (email SKIPPED, still 200).
# In strict (Preview/Production) they are REQUIRED or the request returns 500.
RESEND_API_KEY=
WAITLIST_FROM="Floriente Cattery <waitlist@florientecattery.com>"
WAITLIST_NOTIFY_TO=info@florientecattery.com

# ── Anti-spam (optional) ─────────────────────────────────────
# When set, Turnstile is enforced. When empty, only honeypot + fill-time apply.
TURNSTILE_SECRET_KEY=

# ── Storage (Cloudflare D1) ──────────────────────────────────
# D1 is a BINDING, not a secret — it lives in wrangler.toml ([[d1_databases]])
# for local dev and in the Cloudflare Pages dashboard for Preview/Production.
# There is nothing to put here for D1. Apply the schema before first use:
#   npx wrangler d1 execute floriente-waitlist-preview --local --file=db/schema.sql
