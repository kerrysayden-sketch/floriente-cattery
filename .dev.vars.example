# Template for LOCAL Pages-function secrets used by `wrangler pages dev`.
# Copy to `.dev.vars` (gitignored) and fill with REAL values for local e2e.
# DO NOT put real values here. DO NOT commit `.dev.vars`.
#
# In preview/production these are set as env vars / secrets in the
# Cloudflare Pages project (Settings → Environment variables). See WAITLIST-SETUP.md.

# ── Safety mode ──────────────────────────────────────────────
# Allow degraded mode (skip unconfigured notify/sheet and still return 200).
# Set 'true' for LOCAL/PREVIEW only. In PRODUCTION leave this UNSET — strict
# mode then returns 500 'config' if notification email is not configured, so a
# misconfigured prod can never silently accept and lose a lead.
WAITLIST_ALLOW_DEGRADED=true

# ── Notification email (Resend) ──────────────────────────────
# In degraded mode these may be empty (email SKIPPED, still 200).
# In strict/production mode they are REQUIRED or the request returns 500.
RESEND_API_KEY=
WAITLIST_FROM="Floriente Cattery <waitlist@florientecattery.com>"
WAITLIST_NOTIFY_TO=info@florientecattery.com

# ── Anti-spam (optional) ─────────────────────────────────────
# When set, Turnstile is enforced. When empty, only honeypot + fill-time apply.
TURNSTILE_SECRET_KEY=

# ── Google Sheet (optional in dev; REQUIRED for production acceptance) ──
# Service account with edit access to the sheet. PRIVATE_KEY may contain literal
# \n sequences (they are normalized at runtime).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE="Waitlist!A:S"
